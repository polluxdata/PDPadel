# Supabase (project > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# URL pública de la app (para los enlaces de magic link / invitación)
APP_URL=http://localhost:3000

# SMTP (OCI Email Delivery). SOLO para el servidor, nunca NEXT_PUBLIC_.
SMTP_HOST=smtp.email.us-ashburn-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USER=ocid1.user...@ocid1.tenancy...
SMTP_PASS=la-password-generada
EMAIL_FROM=no-reply@tudominio-verificado.com

# PIN del usuario 0 (super admin). Se crea automáticamente al primer
# arranque con usuario "superadmin".
SUPER_ADMIN_PIN=0000
SUPER_ADMIN_EMAIL=tu-correo@dominio.com
