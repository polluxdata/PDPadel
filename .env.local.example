# Supabase (project > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# PIN del usuario 0 (super admin). Se crea automáticamente al primer
# arranque con usuario "superadmin".
SUPER_ADMIN_PIN=0000

# Secreto para el token diario de registro (se regenera cada día).
APP_TOKEN_SECRET=cambia-este-secreto
